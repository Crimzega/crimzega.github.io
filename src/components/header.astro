<header>
				<div id="icon">
					<svg class="drawer-handler" height="90" viewBox="0 0 640 480" version="1.2" width="120" xmlns="http://www.w3.org/2000/svg">
						<radialGradient id="bg-base">
							<stop offset="0%" stop-color="hsl(224, 76%, 58%)" />
							<stop offset="64%" stop-color="hsl(146, 90%, 62%)" />
							<stop offset="78%" stop-color="hsl(46, 86%, 72%)" />
							<stop offset="100%" stop-color="hsla(0, 0%, 50%, 0)" />
						</radialGradient>
						<radialGradient id="bg-base-hover">
							<stop offset="0%" stop-color="hsl(216, 48%, 12%)" />
							<stop offset="64%" stop-color="hsl(262, 74%, 52%)" />
							<stop offset="78%" stop-color="hsl(316, 80%, 76%)" />
							<stop offset="100%" stop-color="hsla(0, 0%, 50%, 0)" />
						</radialGradient>
						<radialGradient id="bg-dark">
							<stop offset="0%" stop-color="hsl(216, 48%, 6%)" />
							<stop offset="64%" stop-color="hsl(262, 74%, 26%)" />
							<stop offset="78%" stop-color="hsl(316, 52%, 32%)" />
							<stop offset="100%" stop-color="hsla(0, 0%, 50%, 0)" />
						</radialGradient>
						<radialGradient id="bg-dark-hover">
							<stop offset="0%" stop-color="hsl(224, 36%, 18%)" />
							<stop offset="64%" stop-color="hsl(146, 40%, 22%)" />
							<stop offset="78%" stop-color="hsl(84, 54%, 22%)" />
							<stop offset="100%" stop-color="hsla(0, 0%, 50%, 0)" />
						</radialGradient>
						<g id="graphic-data">
							<g class="back">
								<ellipse cx="320" cy="240" rx="320" ry="240" />
							</g>
							<g class="site-text">
								<text x="52.6" y="229">Crimzega's</text>
								<text x="128.22" y="362">Website</text>
							</g>
						</g>
					</svg>
				</div>
				<div id="search">
					<form action="search/">
						<input name="query" />
						<button type="submit">
							<svg height="24", viewBox="0 0 32 32" width="24" xmlns="http://www.w3.org/2000/svg">
								<style>
								g{
									stroke-linecap: round;
									stroke-linejoin: round;
								}
								.glass{
									stroke: var(--search-icon-color);
									fill: none;
								}
								.handle{
									stroke: none;
									fill: var(--search-icon-color);
								}
								.handle rect{
									transform: rotateZ(45deg);
									transform-origin: center;
								}
								</style>
								<g class="glass">
									<ellipse cx="22.8" cy="9.2" stroke-width="2.2" rx="8.5" ry="8.5" />
									<path d="M17.78,10.55 A5.2,5.2,0,0,1,24.15,4.18" stroke-width='1.2' />
								</g>
								<g class="handle">
									<rect height="4" stroke-width="0.8" width="2" x="15" y="16" />
									<rect height="18" stroke-width="1.4" width="4" x="14" y="19" />
								</g>
							</svg>
						</button>
					</form>
				</div>
				<div id="empty"></div>
			</header>
